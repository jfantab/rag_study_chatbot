# ============================================================================
# Environment Configuration Example
# ============================================================================
# Copy this file to .env and fill in your actual values
#
# Required Python Version: 3.13+
# Installation: cp .env.example .env
# ============================================================================

# Environment Mode (development or production)
ENVIRONMENT=development

# Server Configuration
PORT=8000
DEBUG=False

# CORS Configuration (comma-separated list of allowed origins, or * for all)
# Production: Set to your frontend domain(s)
# Example: ALLOWED_ORIGINS=https://yourapp.com,https://www.yourapp.com
ALLOWED_ORIGINS=*

# File Upload Configuration
MAX_UPLOAD_SIZE_MB=100

# AWS Configuration
AWS_REGION=us-east-1

# AWS Cognito
COGNITO_USER_POOL_ID=your_user_pool_id_here
COGNITO_CLIENT_ID=your_client_id_here
COGNITO_IDENTITY_POOL_ID=your_identity_pool_id_here

# S3 Buckets
S3_IMAGE_BUCKET=ragchatbotimages
S3_DOCUMENT_BUCKET=rag-doc-store

# Voice Service
VOICE_S3_BUCKET=voice-agent-audio-bucket
VOICE_DEFAULT_MODEL=us.anthropic.claude-sonnet-4-20250514-v1:0

# Encryption Configuration
# CRITICAL: Set these in production! Generate strong random keys
# Example: openssl rand -base64 32
CHAT_ENCRYPTION_KEY=your_encryption_key_here
ENCRYPTION_SALT=your_encryption_salt_here

# Knowledge Base
KNOWLEDGE_BASE_ID=ADEGC5Q4KM

# LangChain Configuration (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langchain_api_key_here

# Intent Classification
ENABLE_INTENT_CLASSIFICATION=true

# ============================================================================
# DynamoDB Chat History Configuration
# ============================================================================
# USE_NEW_MESSAGE_TABLE controls which storage approach is used for chat history
#
# false (default): Old approach - entire chat history in one DynamoDB item
#   - Simple but has 400KB size limit per chat
#   - Expensive for edit/delete operations (reads/writes entire history)
#
# true: New approach - one DynamoDB item per message
#   - No size limit (scales to millions of messages)
#   - 99%+ cost reduction for edit/delete operations (1-2 WCUs vs 100s)
#   - Better performance (only read/write what you need)
#
# Migration Steps:
# 1. Keep this false initially
# 2. Run: python migrations/migrate.py --all --dry-run
# 3. Run: python migrations/migrate.py --all
# 4. Set to true and restart server
# 5. See migrations/README.md for full migration guide
USE_NEW_MESSAGE_TABLE=false
